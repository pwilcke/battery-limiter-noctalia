#!/usr/bin/python3 -I
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys

TOOL = Path("/usr/local/libexec/framework-charge-tool")
LOCK = Path("/run/framework-charge-limit.lock")
POWER_SUPPLY = Path("/sys/class/power_supply")
PRESETS = ("50", "60", "70", "80", "100")


def main(arguments: list[str]) -> None:
    if arguments != ["read"] and not (
        len(arguments) == 2 and arguments[0] == "set" and arguments[1] in PRESETS
    ):
        raise ValueError("Charge-limit request is invalid.")
    if os.geteuid() != 0:
        raise ValueError("Charge-limit access requires root.")
    target = int(arguments[1]) if arguments[0] == "set" else None
    vendor = Path("/sys/class/dmi/id/sys_vendor").read_text().strip()
    model = Path("/sys/class/dmi/id/product_name").read_text().strip()
    version = Path("/sys/class/dmi/id/product_version").read_text().strip()
    with LOCK.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if vendor == "Framework" and model == "Laptop 13 Pro (Intel Core Ultra Series 3)":
            maximum = framework(target)
        elif vendor == "LENOVO" and version.startswith("ThinkPad"):
            maximum = thinkpad(target)
        else:
            raise ValueError(f"Charge-limit access does not support {vendor} {model}.")
    if target is not None and maximum != target:
        raise ValueError(f"Charge-limit readback returned {maximum}%.")
    print(json.dumps({"limit": maximum}))


def framework(target: int | None) -> int:
    command = [str(TOOL), "--driver", "cros-ec", "--charge-limit"]
    if target is not None:
        command.append(str(target))
    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        timeout=15,
        env={"PATH": "/usr/bin:/usr/sbin"},
        check=False,
    )
    if result.returncode != 0:
        raise ValueError(
            f"Framework charge-limit command failed with exit code {result.returncode}."
        )
    match = re.fullmatch(r"Minimum \d+%, Maximum (\d+)%", result.stdout.strip())
    if match is None or not 25 <= int(match[1]) <= 100:
        raise ValueError("Framework charge-limit command returned an invalid limit.")
    return int(match[1])


def thinkpad(target: int | None) -> int:
    batteries = sorted(
        battery
        for battery in POWER_SUPPLY.glob("BAT*")
        if (battery / "charge_control_end_threshold").exists()
    )
    if not batteries:
        raise ValueError("ThinkPad battery has no charge_control_end_threshold.")
    if target is not None:
        # Charging resumes below the start threshold. 0 is the firmware default:
        # charge whenever below the end threshold.
        start = 0 if target == 100 else target - 5
        for battery in batteries:
            start_file = battery / "charge_control_start_threshold"
            end_file = battery / "charge_control_end_threshold"
            # thinkpad_acpi rejects a start above the current end, and an end below
            # the current start. Writing in this order keeps the pair valid after
            # each write.
            if start < int(end_file.read_text()):
                start_file.write_text(str(start))
                end_file.write_text(str(target))
            else:
                end_file.write_text(str(target))
                start_file.write_text(str(start))
    maximum = int((batteries[0] / "charge_control_end_threshold").read_text())
    if not 1 <= maximum <= 100:
        raise ValueError("ThinkPad charge_control_end_threshold holds an invalid limit.")
    return maximum


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.TimeoutExpired:
        print("Framework charge-limit command timed out.", file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
