#!/usr/bin/python3 -I
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys

TOOL = Path("/usr/local/libexec/framework-charge-tool")
LOCK = Path("/run/framework-charge-limit.lock")
PRESETS = ("50", "60", "70", "80", "100")


def main(arguments: list[str]) -> None:
    if arguments != ["read"] and not (
        len(arguments) == 2 and arguments[0] == "set" and arguments[1] in PRESETS
    ):
        raise ValueError("Charge-limit request is invalid.")
    if os.geteuid() != 0:
        raise ValueError("Charge-limit access requires root.")
    vendor = Path("/sys/class/dmi/id/sys_vendor").read_text().strip()
    model = Path("/sys/class/dmi/id/product_name").read_text().strip()
    if vendor != "Framework" or model != "Laptop 13 Pro (Intel Core Ultra Series 3)":
        raise ValueError(f"Charge-limit access does not support {model}.")

    command = [str(TOOL), "--driver", "cros-ec", "--charge-limit"]
    if arguments[0] == "set":
        command.append(arguments[1])
    with LOCK.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=15,
            env={"PATH": "/usr/bin:/usr/sbin"},
            check=False,
        )
    if result.returncode != 0:
        raise ValueError(
            f"Framework charge-limit command failed with exit code {result.returncode}."
        )
    match = re.fullmatch(r"Minimum \d+%, Maximum (\d+)%", result.stdout.strip())
    if match is None or not 25 <= int(match[1]) <= 100:
        raise ValueError("Framework charge-limit command returned an invalid limit.")
    maximum = int(match[1])
    if arguments[0] == "set" and maximum != int(arguments[1]):
        raise ValueError(f"Framework charge-limit readback returned {maximum}%.")
    print(json.dumps({"limit": maximum}))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.TimeoutExpired:
        print("Framework charge-limit command timed out.", file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
