{
  "id": "framework-charge",
  "name": "Framework Charge",
  "author": "pwilcke",
  "description": "Choose the battery charge limit on a Framework Laptop 13 Pro or a ThinkPad.",
  "version": "0.3.0",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "icon": "battery-eco",
    "defaultSettings": {
      "workHours": false,
      "workDays": "weekdays",
      "workStart": "08:00",
      "workEnd": "16:00",
      "workLimit": 50,
      "afterWorkLimit": 80,
      "tolerance": 3,
      "learnRates": true
    }
  }
}
