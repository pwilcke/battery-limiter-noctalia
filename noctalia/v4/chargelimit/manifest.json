{
  "id": "chargelimit",
  "name": "Charge Limit",
  "author": "pwilcke, Jan Hindges",
  "description": "Choose the battery charge limit, hold one while you work, and charge by a time.",
  "version": "0.4.0",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "icon": "battery-eco",
    "defaultSettings": {
      "workHours": false,
      "workDays": "weekdays",
      "workStart": "08:00",
      "workEnd": "16:00",
      "workLimit": 50,
      "afterWorkLimit": 80,
      "tolerance": 3,
      "learnRates": true
    }
  }
}
